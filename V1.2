<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Nereus — Offshore Data Infrastructure</title>

  <meta
    name="description"
    content="Nereus is a proposed offshore data center infrastructure concept built around a modified offshore oil platform."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --black: #050505;
      --black-2: #111111;
      --white: #ffffff;
      --surface: #ffffff;
      --background: #f5f5f5;
      --surface-dark: #ededed;

      --text-main: #090909;
      --text-muted: #6d6d6d;
      --text-light: #999999;

      --border: #dedede;
      --border-dark: #c7c7c7;

      --accent: #000000;
      --accent-soft: #eeeeee;

      --radius: 16px;
      --radius-small: 12px;

      --shadow:
        0 12px 35px rgba(0, 0, 0, 0.055);

      --shadow-hover:
        0 18px 45px rgba(0, 0, 0, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Plus Jakarta Sans", sans-serif;
      background: var(--background);
      color: var(--text-main);
      min-height: 100vh;
      line-height: 1.6;
    }

    button,
    input,
    select {
      font-family: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =========================================
       LAYOUT
    ========================================= */

    .app {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 18px 80px;
    }

    .section {
      scroll-margin-top: 100px;
      margin-top: 22px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    /* =========================================
       NAVIGATION
    ========================================= */

    .nav {
      position: sticky;
      top: 14px;
      z-index: 100;

      display: flex;
      align-items: center;
      justify-content: space-between;

      min-height: 58px;
      padding: 8px 8px 8px 18px;

      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(18px);

      border: 1px solid var(--border);
      border-radius: 999px;

      box-shadow: 0 10px 30px rgba(0,0,0,.06);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .brand-mark {
      width: 30px;
      height: 30px;

      display: grid;
      place-items: center;

      background: var(--black);
      color: white;

      border-radius: 9px;
      font-size: .75rem;
      font-weight: 800;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-link {
      padding: 9px 13px;
      border-radius: 999px;

      color: var(--text-muted);
      font-size: .78rem;
      font-weight: 700;

      transition: .2s ease;
    }

    .nav-link:hover,
    .nav-link.active {
      background: var(--accent-soft);
      color: var(--black);
    }

    .nav-button {
      border: 0;
      background: var(--black);
      color: white;

      padding: 10px 17px;
      border-radius: 999px;

      font-size: .78rem;
      font-weight: 700;

      transition: .2s ease;
    }

    .nav-button:hover {
      transform: translateY(-1px);
      background: #222;
    }

    /* =========================================
       HERO
    ========================================= */

    .hero {
      position: relative;
      overflow: hidden;

      padding: 72px 62px 52px;
      margin-top: 22px;
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .45;

      background-image:
        linear-gradient(#e9e9e9 1px, transparent 1px),
        linear-gradient(90deg, #e9e9e9 1px, transparent 1px);

      background-size: 42px 42px;

      mask-image:
        linear-gradient(to bottom, black, transparent 75%);
    }

    .hero-content {
      position: relative;
      max-width: 790px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      background: var(--black);
      color: white;

      padding: 7px 12px;
      border-radius: 999px;

      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;

      margin-bottom: 22px;
    }

    .eyebrow-dot {
      width: 6px;
      height: 6px;
      background: white;
      border-radius: 50%;
    }

    .hero h1 {
      font-size: clamp(3.4rem, 8vw, 6.8rem);
      line-height: .92;
      letter-spacing: -.075em;
      font-weight: 800;
      max-width: 850px;
    }

    .hero h1 span {
      color: #777;
    }

    .hero-description {
      max-width: 680px;
      margin-top: 26px;

      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 30px;
    }

    .primary-button,
    .secondary-button {
      border-radius: 12px;
      padding: 13px 18px;

      font-size: .86rem;
      font-weight: 700;

      transition: .2s ease;
    }

    .primary-button {
      background: var(--black);
      color: white;
      border: 1px solid var(--black);
    }

    .primary-button:hover {
      transform: translateY(-2px);
      background: #222;
    }

    .secondary-button {
      background: white;
      color: var(--black);
      border: 1px solid var(--border-dark);
    }

    .secondary-button:hover {
      border-color: var(--black);
      transform: translateY(-2px);
    }

    /* =========================================
       HERO METRICS
    ========================================= */

    .metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;

      margin-top: 28px;
    }

    .metric {
      background: #f7f7f7;
      border: 1px solid var(--border);

      padding: 20px;
      border-radius: 13px;
    }

    .metric-value {
      font-size: 1.65rem;
      line-height: 1;

      font-weight: 800;
      letter-spacing: -.045em;
    }

    .metric-label {
      margin-top: 8px;

      color: var(--text-muted);
      font-size: .72rem;
      line-height: 1.4;
      font-weight: 600;
    }

    /* =========================================
       SECTION HEADER
    ========================================= */

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;

      margin-bottom: 12px;
      padding: 0 4px;
    }

    .section-number {
      color: #999;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .section-title {
      margin-top: 3px;

      font-size: 1.45rem;
      line-height: 1.2;
      letter-spacing: -.04em;
      font-weight: 800;
    }

    .section-description {
      max-width: 520px;

      color: var(--text-muted);
      font-size: .82rem;
      line-height: 1.6;
      text-align: right;
    }

    /* =========================================
       OVERVIEW
    ========================================= */

    .overview {
      padding: 34px;
    }

    .overview-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 42px;
      align-items: center;
    }

    .overview-copy h2 {
      font-size: 2rem;
      line-height: 1.15;
      letter-spacing: -.05em;
      margin-bottom: 17px;
    }

    .overview-copy p {
      color: var(--text-muted);
      font-size: .9rem;
      line-height: 1.8;
      margin-bottom: 14px;
    }

    /* =========================================
       SYSTEM DIAGRAM
    ========================================= */

    .diagram {
      position: relative;

      min-height: 370px;
      padding: 20px;

      background:
        radial-gradient(circle at center, #fff 0, #f5f5f5 72%);

      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
    }

    .diagram-grid {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(#e6e6e6 1px, transparent 1px),
        linear-gradient(90deg, #e6e6e6 1px, transparent 1px);

      background-size: 30px 30px;
      opacity: .5;
    }

    .rig {
      position: absolute;
      left: 50%;
      top: 42px;

      width: 145px;
      height: 250px;

      transform: translateX(-50%);
    }

    .rig-top {
      position: absolute;
      top: 0;
      left: 18px;
      right: 18px;
      height: 30px;

      background: #111;
      border-radius: 5px;
    }

    .rig-body {
      position: absolute;
      top: 30px;
      left: 32px;
      right: 32px;
      height: 160px;

      background:
        repeating-linear-gradient(
          90deg,
          transparent 0,
          transparent 19px,
          #222 20px,
          #222 22px
        );

      border-left: 5px solid #111;
      border-right: 5px solid #111;
    }

    .rig-platform {
      position: absolute;
      left: 7px;
      right: 7px;
      height: 10px;
      background: #111;
      border-radius: 3px;
    }

    .platform-1 { top: 43px; }
    .platform-2 { top: 87px; }
    .platform-3 { top: 131px; }
    .platform-4 { top: 175px; }

    .water {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 82px;

      background:
        repeating-linear-gradient(
          -8deg,
          #ddd 0,
          #ddd 2px,
          transparent 2px,
          transparent 16px
        );

      border-top: 1px solid #bbb;
    }

    .water-label {
      position: absolute;
      bottom: 12px;
      left: 16px;

      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .1em;
      color: #777;
      text-transform: uppercase;
    }

    .diagram-label {
      position: absolute;

      background: white;
      border: 1px solid var(--border);

      padding: 8px 10px;
      border-radius: 8px;

      font-size: .65rem;
      font-weight: 700;

      box-shadow: 0 5px 15px rgba(0,0,0,.05);
    }

    .label-data {
      top: 75px;
      right: 15px;
    }

    .label-cooling {
      bottom: 112px;
      left: 15px;
    }

    .label-power {
      top: 22px;
      left: 15px;
    }

    /* =========================================
       PRINCIPLES GRID
    ========================================= */

    .principles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .principle {
      padding: 26px;
      min-height: 220px;

      transition:
        transform .25s ease,
        box-shadow .25s ease;
    }

    .principle:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .principle-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      width: 32px;
      height: 32px;

      background: var(--black);
      color: white;
      border-radius: 9px;

      font-size: .68rem;
      font-weight: 800;

      margin-bottom: 28px;
    }

    .principle h3 {
      font-size: 1rem;
      margin-bottom: 9px;
      letter-spacing: -.025em;
    }

    .principle p {
      color: var(--text-muted);
      font-size: .8rem;
      line-height: 1.7;
    }

    /* =========================================
       TECHNICAL SECTIONS
    ========================================= */

    .technical-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .technical-card {
      padding: 30px;
    }

    .technical-card.full {
      grid-column: 1 / -1;
    }

    .technical-icon {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      background: var(--black);
      color: white;

      border-radius: 11px;

      font-size: .7rem;
      font-weight: 800;

      margin-bottom: 22px;
    }

    .technical-card h3 {
      font-size: 1.25rem;
      letter-spacing: -.035em;
      margin-bottom: 12px;
    }

    .technical-card p {
      color: var(--text-muted);
      font-size: .84rem;
      line-height: 1.8;
    }

    .technical-card p + p {
      margin-top: 12px;
    }

    /* =========================================
       FLOW
    ========================================= */

    .flow {
      padding: 30px;
    }

    .flow-list {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
    }

    .flow-step {
      position: relative;
      padding: 20px 14px;

      background: #f5f5f5;
      border: 1px solid var(--border);
      border-radius: 12px;

      min-height: 150px;
    }

    .flow-step::after {
      content: "→";

      position: absolute;
      right: -13px;
      top: 50%;

      transform: translateY(-50%);

      z-index: 2;

      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      background: var(--black);
      color: white;

      border-radius: 50%;

      font-size: .65rem;
      font-weight: 800;
    }

    .flow-step:last-child::after {
      display: none;
    }

    .flow-number {
      color: #999;
      font-size: .65rem;
      font-weight: 800;
    }

    .flow-step h4 {
      margin-top: 25px;
      font-size: .82rem;
    }

    .flow-step p {
      margin-top: 5px;

      color: var(--text-muted);
      font-size: .68rem;
      line-height: 1.5;
    }

    /* =========================================
       AEOLOUS
    ========================================= */

    .aeolus {
      background: var(--black);
      color: white;
      border-color: var(--black);

      overflow: hidden;
      position: relative;
    }

    .aeolus::before {
      content: "AEOLUS";

      position: absolute;
      right: -10px;
      bottom: -50px;

      font-size: 10rem;
      line-height: 1;

      font-weight: 800;
      letter-spacing: -.1em;

      color: rgba(255,255,255,.035);
      pointer-events: none;
    }

    .aeolus-grid {
      position: relative;
      z-index: 2;

      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 55px;

      padding: 42px;
    }

    .aeolus-label {
      color: #999;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .aeolus h2 {
      margin-top: 10px;

      font-size: 3.2rem;
      line-height: 1;
      letter-spacing: -.07em;
    }

    .aeolus-intro {
      margin-top: 18px;

      color: #aaa;
      font-size: .84rem;
      line-height: 1.75;
    }

    .aeolus-content {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .aeolus-card {
      padding: 20px;

      background: #111;
      border: 1px solid #292929;
      border-radius: 12px;
    }

    .aeolus-card h3 {
      font-size: .85rem;
      margin-bottom: 7px;
    }

    .aeolus-card p {
      color: #999;
      font-size: .72rem;
      line-height: 1.65;
    }

    /* =========================================
       ALGAE PROCESS
    ========================================= */

    .process {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }

    .process-step {
      padding: 25px;

      border: 1px solid var(--border);
      background: white;
      border-radius: 12px;
    }

    .process-step strong {
      display: block;

      font-size: 2rem;
      letter-spacing: -.06em;
      line-height: 1;
    }

    .process-step h3 {
      margin-top: 25px;
      font-size: .9rem;
    }

    .process-step p {
      margin-top: 7px;

      color: var(--text-muted);
      font-size: .75rem;
      line-height: 1.65;
    }

    /* =========================================
       BUSINESS MODEL
    ========================================= */

    .business-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .business-card {
      padding: 32px;
    }

    .business-card h3 {
      font-size: 1.25rem;
      letter-spacing: -.04em;
      margin-bottom: 10px;
    }

    .business-card p {
      color: var(--text-muted);
      font-size: .82rem;
      line-height: 1.75;
    }

    .fee-list {
      margin-top: 25px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .fee {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 14px;

      background: #f5f5f5;
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .fee span:first-child {
      color: var(--text-muted);
      font-size: .74rem;
      font-weight: 600;
    }

    .fee strong {
      font-size: .82rem;
    }

    .revenue-box {
      margin-top: 10px;
      padding: 25px;

      background: var(--black);
      color: white;
      border-radius: 12px;
    }

    .revenue-label {
      color: #999;
      font-size: .68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .revenue-value {
      margin-top: 5px;

      font-size: 2.5rem;
      line-height: 1;
      letter-spacing: -.06em;
      font-weight: 800;
    }

    /* =========================================
       ASSUMPTIONS
    ========================================= */

    .assumptions {
      padding: 30px;
    }

    .assumption-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .assumption {
      display: grid;
      grid-template-columns: 42px 1fr auto;
      gap: 18px;
      align-items: center;

      padding: 17px 0;

      border-bottom: 1px solid var(--border);
    }

    .assumption:last-child {
      border-bottom: 0;
    }

    .assumption-number {
      color: #999;
      font-size: .68rem;
      font-weight: 800;
    }

    .assumption-title {
      font-size: .8rem;
      font-weight: 700;
    }

    .assumption-detail {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: .7rem;
    }

    .assumption-value {
      padding: 6px 9px;

      background: #f0f0f0;
      border-radius: 7px;

      font-size: .7rem;
      font-weight: 800;
      white-space: nowrap;
    }

    /* =========================================
       ACCORDION
    ========================================= */

    .accordion {
      padding: 30px;
    }

    .accordion-item {
      border-bottom: 1px solid var(--border);
    }

    .accordion-item:last-child {
      border-bottom: 0;
    }

    .accordion-button {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 19px 0;

      background: transparent;
      border: 0;

      text-align: left;
      color: var(--black);

      font-size: .85rem;
      font-weight: 700;
    }

    .accordion-symbol {
      width: 27px;
      height: 27px;

      display: grid;
      place-items: center;

      background: #f0f0f0;
      border-radius: 50%;

      font-size: 1rem;

      transition: transform .25s ease;
    }

    .accordion-item.open .accordion-symbol {
      transform: rotate(45deg);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;

      color: var(--text-muted);
      font-size: .78rem;
      line-height: 1.75;

      transition: max-height .3s ease;
    }

    .accordion-content-inner {
      padding: 0 0 20px;
    }

    /* =========================================
       FOOTER
    ========================================= */

    footer {
      margin-top: 22px;

      padding: 30px;

      background: var(--black);
      color: white;

      border-radius: var(--radius);
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 30px;
    }

    .footer-brand {
      font-size: 1.1rem;
      font-weight: 800;
    }

    .footer-copy {
      max-width: 460px;

      margin-top: 7px;

      color: #999;
      font-size: .72rem;
      line-height: 1.7;
    }

    .footer-note {
      color: #777;
      font-size: .65rem;
      text-align: right;
    }

    /* =========================================
       MODAL
    ========================================= */

    .modal-overlay {
      position: fixed;
      inset: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 20px;

      background: rgba(0,0,0,.55);
      backdrop-filter: blur(7px);

      z-index: 1000;

      opacity: 0;
      pointer-events: none;

      transition: opacity .2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal {
      width: 100%;
      max-width: 600px;

      background: white;
      border-radius: 16px;
      border: 1px solid var(--border);

      padding: 30px;

      transform: translateY(15px);
      transition: transform .25s ease;
    }

    .modal-overlay.active .modal {
      transform: translateY(0);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 20px;
    }

    .modal-title {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: -.035em;
    }

    .modal-close {
      width: 34px;
      height: 34px;

      border: 0;
      background: #f0f0f0;

      border-radius: 50%;

      font-size: 1.1rem;
    }

    .modal p {
      color: var(--text-muted);
      font-size: .8rem;
      line-height: 1.75;
    }

    /* =========================================
       SCROLL PROGRESS
    ========================================= */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1001;

      height: 3px;
      width: 0%;

      background: var(--black);
    }

    /* =========================================
